---
/**
 * Centered layout wrapper with consistent horizontal padding.
 * `wide` opts into the wider max-width for full sections; the default is the
 * narrower reading column.
 */
interface Props {
  wide?: boolean
  as?: string
  class?: string
}

const { wide = false, as: Tag = 'div', class: className } = Astro.props
---

<Tag class:list={['container', wide && 'container--wide', className]}>
  <slot />
</Tag>

<style>
  .container {
    width: 100%;
    max-width: var(--content-width);
    margin-inline: auto;
    padding-inline: var(--space-md);
  }
  .container--wide {
    max-width: var(--wide-width);
  }
</style>
