---
/**
 * A single upcoming event: name, human-readable date (range), location, short
 * description, and a registration link. Only future/current events are queried
 * for on the page, so no "past event" state is needed here.
 */
interface Props {
  event: {
    title?: string
    startDate?: string
    endDate?: string
    description?: string
    location?: string
    url?: string
  }
}

const { event } = Astro.props

const dateFmt = new Intl.DateTimeFormat('en-US', {
  weekday: 'short',
  month: 'long',
  day: 'numeric',
  year: 'numeric',
})

function formatRange(start?: string, end?: string): string {
  if (!start) return ''
  const startDate = new Date(start)
  if (!end) return dateFmt.format(startDate)
  const endDate = new Date(end)
  // Same calendar day → single date.
  if (startDate.toDateString() === endDate.toDateString()) {
    return dateFmt.format(startDate)
  }
  return `${dateFmt.format(startDate)} – ${dateFmt.format(endDate)}`
}

const dateLabel = formatRange(event.startDate, event.endDate)
---

<article class="event-card">
  <div class="event-card__body">
    {dateLabel && (
      <p class="event-card__date">
        <time datetime={event.startDate}>{dateLabel}</time>
      </p>
    )}
    <h3 class="event-card__title">{event.title}</h3>
    {event.location && <p class="event-card__location">{event.location}</p>}
    {event.description && <p class="event-card__desc">{event.description}</p>}
  </div>
  {event.url && (
    <a class="event-card__cta" href={event.url} target="_blank" rel="noopener noreferrer">
      Register<span class="sr-only"> for {event.title} (opens in a new tab)</span> →
    </a>
  )}
</article>

<style>
  .event-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-primary);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
  }

  .event-card__date {
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--color-accent-strong);
    margin: 0 0 var(--space-xs);
  }

  .event-card__title {
    margin: 0 0 var(--space-xs);
    font-size: var(--text-lg);
  }

  .event-card__location {
    color: var(--color-text-muted);
    margin: 0 0 var(--space-sm);
    font-size: var(--text-base);
  }

  .event-card__desc {
    color: var(--color-text-muted);
    margin: 0;
  }

  .event-card__cta {
    align-self: flex-start;
    font-weight: 600;
    color: var(--color-primary-strong);
    text-decoration: none;
  }
  .event-card__cta:hover {
    text-decoration: underline;
  }
</style>
