---
/**
 * Editorial site header: a bordered monogram + wordmark on the left, a
 * lightweight primary nav on the right. This is a single-page site, so nav
 * points at landing-page sections; the `navLinks` array is the single place to
 * add or reorder items as the site grows.
 *
 * On desktop the links sit inline. On mobile they collapse behind a round menu
 * button, toggled with a hidden checkbox (no JavaScript): the button is a label
 * for the checkbox, and :checked reveals the dropdown. Keyboard-accessible via
 * the focusable checkbox, whose focus ring is forwarded to the visible button.
 */
import { urlFor } from '../lib/sanity'

interface Props {
  settings?: {
    organizationName?: string
    shortName?: string
    logo?: { asset?: unknown }
  } | null
}

const { settings } = Astro.props
const orgName = settings?.organizationName || 'Universal Design Coalition'
const monogram = (settings?.shortName || 'UDC').slice(0, 4).toUpperCase()

// When a logo is uploaded in Site Settings it replaces the monogram + wordmark.
const logoUrl = settings?.logo?.asset
  ? urlFor(settings.logo).height(200).fit('max').auto('format').url()
  : null

// In-page anchor menu. Each href points at a section id on the landing page;
// this array is the single place to add, remove, or reorder items.
const navLinks = [
  { text: 'Home', href: '#top' },
  { text: 'About', href: '#what-is-universal-design' },
  { text: 'Why it matters', href: '#why-it-matters' },
  { text: 'Falls prevention', href: '#fall-prevention' },
  { text: 'In practice', href: '#in-practice' },
  { text: 'Resources', href: '#resources' },
  { text: 'Sponsors', href: '#sponsors' },
  { text: 'Contact', href: '#contact' },
]
---

<header class="site-header">
  <div class="site-header__inner">
    {logoUrl ? (
      <a class="wordmark wordmark--logo" href="#top">
        <img class="wordmark__logo" src={logoUrl} alt={`${orgName} — home`} height="48" />
      </a>
    ) : (
      <a class="wordmark" href="#top" aria-label={`${orgName} — home`}>
        <span class="wordmark__mark" aria-hidden="true">
          {monogram.split('').map((letter) => <span>{letter}</span>)}
        </span>
        <span class="wordmark__name">{orgName}</span>
      </a>
    )}

    <div class="nav">
      <input class="nav__cb" type="checkbox" id="site-nav-toggle" aria-label="Toggle navigation menu" />
      <label class="nav__toggle" for="site-nav-toggle" aria-hidden="true">
        <span class="nav__toggle-bars"></span>
      </label>
      <nav class="nav__panel" aria-label="Primary">
        <ul class="nav__list">
          {navLinks.map((link) => (
            <li><a href={link.href}>{link.text}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</header>

<style>
  .site-header {
    background-color: var(--color-bg);
  }

  .site-header__inner {
    max-width: var(--wide-width);
    margin-inline: auto;
    padding: var(--space-md);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
  }

  /* ---- Wordmark ---- */
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    text-decoration: none;
    color: var(--color-green-dark);
  }

  /* Uploaded logo replaces the monogram + wordmark. Sized by height so any
     logo aspect ratio sits cleanly in the header. */
  .wordmark__logo {
    height: 72px;
    width: auto;
    max-width: min(340px, 72vw);
    object-fit: contain;
    display: block;
  }
  @media (max-width: 52rem) {
    .wordmark__logo {
      height: 56px;
    }
  }

  .wordmark__mark {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1.5px solid var(--color-green);
    border-radius: 4px;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 0.8125rem;
    line-height: 1;
    color: var(--color-green);
    flex-shrink: 0;
  }
  /* Center a 3-letter monogram nicely in the 2x2 grid. */
  .wordmark__mark span:first-child {
    grid-column: 1 / -1;
  }

  .wordmark__name {
    font-weight: 700;
    font-size: 0.9375rem;
    letter-spacing: 0.02em;
    line-height: 1.15;
    text-transform: uppercase;
    max-width: 16ch;
  }

  /* ---- Nav (desktop: links inline) ---- */
  .nav {
    display: flex;
    align-items: center;
  }
  .nav__cb,
  .nav__toggle {
    display: none;
  }
  .nav__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md);
  }
  .nav__list a {
    color: var(--color-text);
    text-decoration: none;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    padding-block: 0.25rem;
    border-bottom: 2px solid transparent;
  }
  .nav__list a:hover {
    color: var(--color-green-dark);
    border-bottom-color: var(--color-gold);
  }

  /* ---- Nav (mobile: checkbox-toggled dropdown) ---- */
  @media (max-width: 64rem) {
    .nav {
      position: relative;
    }

    /* The round menu button. */
    .nav__toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.75rem;
      height: 2.75rem;
      border-radius: 50%;
      background-color: var(--color-green);
      color: var(--color-on-green);
      cursor: pointer;
    }
    .nav__toggle-bars,
    .nav__toggle-bars::before,
    .nav__toggle-bars::after {
      display: block;
      width: 1.1rem;
      height: 2px;
      background-color: var(--color-on-green);
      border-radius: 2px;
      position: relative;
    }
    .nav__toggle-bars::before,
    .nav__toggle-bars::after {
      content: '';
      position: absolute;
      left: 0;
    }
    .nav__toggle-bars::before {
      top: -6px;
    }
    .nav__toggle-bars::after {
      top: 6px;
    }

    /* Invisible checkbox overlaying the button: handles click + keyboard,
       while its focus ring is forwarded to the visible button below. */
    .nav__cb {
      display: block;
      position: absolute;
      top: 0;
      right: 0;
      width: 2.75rem;
      height: 2.75rem;
      margin: 0;
      opacity: 0;
      cursor: pointer;
      z-index: 2;
    }
    .nav__cb:focus-visible ~ .nav__toggle {
      outline: 3px solid var(--color-focus);
      outline-offset: 2px;
    }

    .nav__panel {
      display: none;
      position: absolute;
      right: 0;
      top: calc(100% + var(--space-sm));
      width: max-content;
      min-width: 12rem;
      max-width: 78vw;
      background-color: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-soft);
      padding: var(--space-sm);
      z-index: 30;
    }
    .nav__cb:checked ~ .nav__panel {
      display: block;
    }

    .nav__list {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }
    .nav__list a {
      display: block;
      padding: var(--space-sm);
      border-bottom: 1px solid var(--color-border);
    }
    .nav__list li:last-child a {
      border-bottom: 0;
    }
  }
</style>
