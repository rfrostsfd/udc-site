---
/**
 * A small, restrained line-icon set drawn inline as SVG — no icon library, no
 * client JS. Icons are stroked with `currentColor` so they inherit the
 * surrounding text/accent color. They are decorative: every place that uses an
 * icon also shows a text label, and the SVG is hidden from assistive tech.
 *
 * Unknown keys render nothing, so the CMS can reference a key the design
 * doesn't have yet without breaking the page.
 */
interface Props {
  name?: string
  size?: number
  class?: string
}

const { name, size = 28, class: className } = Astro.props

// 24x24 viewBox path data, stroked. Keep shapes simple and calm.
const paths: Record<string, string> = {
  stroller:
    'M5 5h3l3 8M6 13h11a5 5 0 0 0 -6-8M6 13l-1 4M17 13l1 4 M7 20a1.5 1.5 0 1 0 0.01 0M17 20a1.5 1.5 0 1 0 0.01 0',
  briefcase:
    'M4 8h16v11H4zM9 8V6a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2M4 13h16',
  elder:
    'M13 4a1.5 1.5 0 1 0 0.01 0M12 8v6M12 14l-3 6M12 14l3 6M9 11h6M17 8v13',
  injury:
    'M8.5 8.5l7 7M6 10l4-4a2.8 2.8 0 0 1 4 4l-4 4a2.8 2.8 0 0 1-4-4zM11 5l4 4M9 15l4 4',
  accessibility:
    'M12 5a1.4 1.4 0 1 0 0.01 0M12 8v5h4l2 5M12 13H8l-1 5M6 11h5',
  child:
    'M12 4a1.6 1.6 0 1 0 0.01 0M12 8v6M12 14l-3 5M12 14l3 5M8.5 10.5L12 12l3.5-1.5',
  kitchen:
    'M4 4h16v16H4zM4 10h16M8 5.5v3M12 5.5v3M9 14h6v4H9z',
  bath:
    'M5 11V6a2 2 0 0 1 2-2 2 2 0 0 1 2 2M4 11h16v2a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4zM7 20l-1 1M18 20l1 1',
  home:
    'M4 11l8-6 8 6M6 10v9h12v-9M10 19v-5h4v5',
  shield:
    'M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z M9 12l2 2 4-4',
  community:
    'M9 11a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5zM4 19a5 5 0 0 1 10 0M16.5 8.5a2 2 0 1 0 0-4M15 14a5 5 0 0 1 5 5',
}

const d = name ? paths[name] : undefined
---

{
  d && (
    <svg
      class={className}
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      <path d={d} />
    </svg>
  )
}
