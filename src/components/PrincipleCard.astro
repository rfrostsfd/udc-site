---
/**
 * A single Universal Design benefit/principle: a short title and a one-line
 * description. Rendered as a compact card in the Principles grid.
 */
interface Props {
  item: {
    title?: string
    description?: string
  }
}

const { item } = Astro.props
---

<article class="principle">
  <h3 class="principle__title">{item.title}</h3>
  {item.description && <p class="principle__desc">{item.description}</p>}
</article>

<style>
  .principle {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-md) var(--space-lg);
  }

  .principle__title {
    font-size: var(--text-base);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-primary-strong);
    margin: 0 0 var(--space-xs);
  }

  .principle__desc {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-base);
    max-width: none;
  }
</style>
