---
/**
 * A single Universal Design benefit/principle: a short title and a one-line
 * description. Rendered as a light, low-weight item in the Principles grid —
 * a small accent marker and a thin rule instead of a heavy boxed card, so
 * eight of them read as a calm, scannable set rather than a wall of boxes.
 */
interface Props {
  item: {
    title?: string
    description?: string
  }
}

const { item } = Astro.props
---

<div class="principle">
  <h3 class="principle__title">{item.title}</h3>
  {item.description && <p class="principle__desc">{item.description}</p>}
</div>

<style>
  .principle {
    padding-top: var(--space-md);
    border-top: 2px solid var(--color-primary);
  }

  .principle__title {
    font-size: var(--text-base);
    font-weight: 650;
    letter-spacing: 0.02em;
    color: var(--color-text);
    margin: 0 0 var(--space-xs);
  }

  .principle__desc {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-base);
    max-width: none;
  }
</style>
