---
/**
 * Fall-prevention feature band, integrated into the broader Universal Design
 * story rather than presented as a separate medical page. Up to three panels:
 *   - a deep-green statement panel (with an optional image)
 *   - a cream body panel (heading + body + optional "learn more" link)
 *   - a soft sage reassurance panel (shield + one reassuring line)
 * Any panel with no content is omitted and the row reflows.
 */
import { urlFor } from '../lib/sanity'
import Icon from './Icon.astro'

interface Props {
  id?: string
  data?: {
    statement?: string
    heading?: string
    body?: string
    reassurance?: string
    image?: { asset?: unknown; alt?: string }
    link?: { text?: string; link?: string }
  } | null
}

const { id, data } = Astro.props

const paragraphs = (data?.body ?? '')
  .split(/\n\s*\n/)
  .map((p) => p.trim())
  .filter(Boolean)

const imageUrl = data?.image?.asset
  ? urlFor(data.image).width(900).height(680).fit('crop').auto('format').url()
  : null

const hasStatement = !!(data?.statement || imageUrl)
const hasBody = !!(data?.heading || paragraphs.length)
const hasReassurance = !!data?.reassurance
const anything = hasStatement || hasBody || hasReassurance
const link = data?.link
---

{
  anything && (
    <section id={id} class="prevention" aria-label={data?.heading ?? 'Fall prevention'}>
      <div class="prevention__row">
        {hasStatement && (
          <div class="panel panel--statement">
            {data?.statement && <p class="display panel__statement">{data.statement}</p>}
            {data?.statement && imageUrl && <span class="accent-rule accent-rule--gold"></span>}
            {imageUrl && (
              <figure class="panel__figure">
                <img src={imageUrl} alt={data?.image?.alt ?? ''} width="900" height="680" loading="lazy" decoding="async" />
              </figure>
            )}
          </div>
        )}

        {hasBody && (
          <div class="panel panel--body">
            {data?.heading && <h2 class="display panel__heading">{data.heading}</h2>}
            {paragraphs.map((p) => (
              <p class="panel__text">{p}</p>
            ))}
            {link?.text && link?.link && (
              <a class="text-link" href={link.link}>{link.text}</a>
            )}
          </div>
        )}

        {hasReassurance && (
          <div class="panel panel--reassurance">
            <span class="panel__icon" aria-hidden="true"><Icon name="shield" size={34} /></span>
            <p class="panel__reassurance">{data.reassurance}</p>
          </div>
        )}
      </div>
    </section>
  )
}

<style>
  .prevention {
    max-width: var(--wide-width);
    margin-inline: auto;
    padding: var(--space-xl) var(--space-md);
  }

  .prevention__row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .panel {
    flex: 1 1 18rem;
    padding: var(--space-xl) var(--space-lg);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-md);
  }

  /* Left — deep green statement */
  .panel--statement {
    background-color: var(--color-green);
    color: var(--color-on-green);
  }
  .panel__statement {
    font-size: var(--text-2xl);
    margin: 0;
    color: var(--color-on-green);
  }
  .accent-rule--gold {
    margin: 0;
  }
  .panel__figure {
    margin: 0;
  }
  .panel__figure img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  /* Middle — cream body, given a little more room */
  .panel--body {
    flex: 1.3 1 20rem;
    background-color: var(--color-surface);
  }
  .panel__heading {
    font-size: var(--text-2xl);
    margin: 0;
    color: var(--color-text);
  }
  .panel__text {
    color: var(--color-muted);
    font-size: var(--text-base);
    margin: 0;
    max-width: 42ch;
  }

  /* Right — soft sage reassurance. Dark green text on sage keeps AA contrast;
     kept large + semibold for comfortable legibility. */
  .panel--reassurance {
    background-color: var(--color-sage);
    color: var(--color-green-dark);
    align-items: flex-start;
  }
  .panel__icon {
    color: var(--color-green-dark);
    display: inline-flex;
  }
  .panel__reassurance {
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: var(--leading-snug);
    margin: 0;
    color: var(--color-green-dark);
  }
</style>
