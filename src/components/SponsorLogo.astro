---
/**
 * A single sponsor / community partner. Shows the logo when present (on a
 * consistent surface so mismatched logos still read as a set), otherwise
 * falls back to the organization name as text. Recognition, not advertising:
 * no promotional styling, uniform treatment across sponsors.
 */
import { urlFor } from '../lib/sanity'

interface Props {
  sponsor: {
    name?: string
    logo?: any
    url?: string
    description?: string
  }
}

const { sponsor } = Astro.props

const logoUrl = sponsor.logo
  ? urlFor(sponsor.logo).width(320).height(160).fit('max').auto('format').url()
  : null
---

<article class="sponsor">
  {sponsor.url ? (
    <a class="sponsor__link" href={sponsor.url} target="_blank" rel="noopener noreferrer">
      {logoUrl ? (
        <img src={logoUrl} alt={sponsor.name ?? 'Sponsor'} loading="lazy" />
      ) : (
        <span class="sponsor__name">{sponsor.name}</span>
      )}
      <span class="sr-only"> (opens in a new tab)</span>
    </a>
  ) : logoUrl ? (
    <img src={logoUrl} alt={sponsor.name ?? 'Sponsor'} loading="lazy" />
  ) : (
    <span class="sponsor__name">{sponsor.name}</span>
  )}
</article>

<style>
  .sponsor {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    min-height: 7rem;
  }

  .sponsor__link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    text-decoration: none;
  }

  .sponsor img {
    max-height: 5rem;
    width: auto;
    object-fit: contain;
  }

  .sponsor__name {
    font-weight: 600;
    color: var(--color-text);
    text-align: center;
  }
</style>
