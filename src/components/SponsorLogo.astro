---
/**
 * A single sponsor / community partner. Shows the logo when present, sized to
 * fit a consistent container with `object-fit: contain` so logos of different
 * aspect ratios all read as one tidy set. Falls back to a clean name plate
 * when no logo is uploaded. Recognition, not advertising: uniform treatment,
 * generous whitespace, no promotional styling.
 */
import { urlFor } from '../lib/sanity'

interface Props {
  sponsor: {
    name?: string
    logo?: any
    url?: string
  }
}

const { sponsor } = Astro.props

const hasLogo = !!sponsor.logo?.asset
const logoUrl = hasLogo
  ? urlFor(sponsor.logo).width(400).height(200).fit('max').auto('format').url()
  : null

const name = sponsor.name ?? 'Sponsor'
---

<article class="sponsor">
  {sponsor.url ? (
    <a class="sponsor__link" href={sponsor.url} target="_blank" rel="noopener noreferrer">
      {logoUrl ? (
        <img src={logoUrl} alt={name} width="400" height="200" loading="lazy" decoding="async" />
      ) : (
        <span class="sponsor__name">{name}</span>
      )}
      <span class="sr-only"> — visit website (opens in a new tab)</span>
    </a>
  ) : logoUrl ? (
    <img src={logoUrl} alt={name} width="400" height="200" loading="lazy" decoding="async" />
  ) : (
    <span class="sponsor__name">{name}</span>
  )}
</article>

<style>
  .sponsor {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    aspect-ratio: 3 / 2;
  }

  .sponsor__link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    text-decoration: none;
    border-radius: var(--radius-sm);
  }

  .sponsor img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .sponsor__name {
    font-weight: 600;
    color: var(--color-text);
    text-align: center;
    line-height: var(--leading-snug);
  }
</style>
