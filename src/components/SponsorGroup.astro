---
/**
 * One tier of sponsors/partners: a small tier label and a clean, borderless row
 * of logos normalized to a consistent visual height with `object-fit: contain`,
 * so mixed aspect ratios read as one tidy set. Logos link out when a URL
 * exists and fall back to the organization name when no logo is uploaded.
 * `prominent` gives the presenting tier a larger logo size.
 */
import { urlFor } from '../lib/sanity'

interface Sponsor {
  name?: string
  logo?: { asset?: unknown }
  url?: string
}
interface Props {
  label?: string
  items: Sponsor[]
  prominent?: boolean
}

const { label, items, prominent = false } = Astro.props
const sponsors = (items ?? []).filter(Boolean)

function logoUrl(sponsor: Sponsor): string | null {
  return sponsor.logo?.asset
    ? urlFor(sponsor.logo).width(600).fit('max').auto('format').url()
    : null
}
---

{
  sponsors.length > 0 && (
    <div class:list={['group', prominent && 'group--prominent']}>
      {label && <p class="group__label">{label}</p>}
      <ul class="group__logos">
        {sponsors.map((sponsor) => {
          const url = logoUrl(sponsor)
          const name = sponsor.name ?? 'Partner'
          return (
            <li class="group__item">
              {sponsor.url ? (
                <a href={sponsor.url} target="_blank" rel="noopener noreferrer" class="group__link">
                  {url ? (
                    <img src={url} alt={name} loading="lazy" decoding="async" />
                  ) : (
                    <span class="group__name">{name}</span>
                  )}
                  <span class="sr-only"> — visit website (opens in a new tab)</span>
                </a>
              ) : url ? (
                <img src={url} alt={name} loading="lazy" decoding="async" />
              ) : (
                <span class="group__name">{name}</span>
              )}
            </li>
          )
        })}
      </ul>
    </div>
  )
}

<style>
  .group + .group {
    margin-top: var(--space-xl);
  }

  .group__label {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-muted);
    margin: 0 0 var(--space-md);
  }

  .group__logos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    /* Fill the row up to 4 columns, then wrap. auto-fit makes the cards grow
       to fill the space when there are fewer than 4; the max() floor keeps a
       sensible card width so they wrap to 3 / 2 / 1 on smaller screens. */
    grid-template-columns: repeat(
      auto-fit,
      minmax(max(11rem, (100% - 3 * var(--space-md)) / 4), 1fr)
    );
    gap: var(--space-md);
  }

  /* Each logo (or name fallback) sits in a consistent white, rounded card. */
  .group__item {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 6.5rem;
    padding: var(--space-lg);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .group__link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    border-radius: var(--radius-sm);
  }

  .group__item img {
    max-height: 3rem;
    max-width: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  /* Presenting tier gets a taller card and larger logo. */
  .group--prominent .group__item {
    min-height: 8rem;
  }
  .group--prominent .group__item img {
    max-height: 4.5rem;
  }

  .group__name {
    font-weight: 600;
    font-size: var(--text-base);
    color: var(--color-text);
    text-align: center;
    line-height: var(--leading-snug);
  }

  @media (max-width: 40rem) {
    .group__item {
      min-height: 5.5rem;
      padding: var(--space-md);
    }
    .group__item img {
      max-height: 2.5rem;
    }
  }
</style>
