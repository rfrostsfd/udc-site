---
/**
 * The members grid: consistent cards with logos normalized to one visual
 * height with `object-fit: contain`, so mixed aspect ratios read as one tidy
 * set. Cards link out when a URL exists and fall back to the member's name
 * when no logo is uploaded. Recognition, not advertising.
 */
import { urlFor } from '../lib/sanity'

interface Member {
  name?: string
  logo?: { asset?: unknown }
  url?: string
}
interface Props {
  items: Member[]
}

const { items } = Astro.props
const members = (items ?? []).filter(Boolean)

function logoUrl(member: Member): string | null {
  return member.logo?.asset
    ? urlFor(member.logo).width(600).fit('max').auto('format').url()
    : null
}
---

{
  members.length > 0 && (
    <div class="group">
      <ul class="group__logos">
        {members.map((member) => {
          const url = logoUrl(member)
          const name = member.name ?? 'Member'
          return (
            <li class="group__item">
              {member.url ? (
                <a href={member.url} target="_blank" rel="noopener noreferrer" class="group__link">
                  {url ? (
                    <img src={url} alt={name} loading="lazy" decoding="async" />
                  ) : (
                    <span class="group__name">{name}</span>
                  )}
                  <span class="sr-only"> — visit website (opens in a new tab)</span>
                </a>
              ) : url ? (
                <img src={url} alt={name} loading="lazy" decoding="async" />
              ) : (
                <span class="group__name">{name}</span>
              )}
            </li>
          )
        })}
      </ul>
    </div>
  )
}

<style>
  .group__logos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    /* Fill the row up to 4 columns, then wrap. auto-fit makes the cards grow
       to fill the space when there are fewer than 4; the max() floor keeps a
       sensible card width so they wrap to 3 / 2 / 1 on smaller screens. */
    grid-template-columns: repeat(
      auto-fit,
      minmax(max(11rem, (100% - 3 * var(--space-md)) / 4), 1fr)
    );
    gap: var(--space-md);
  }

  /* Each logo (or name fallback) sits in a consistent white, rounded card. */
  .group__item {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 6.5rem;
    padding: var(--space-lg);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .group__link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    border-radius: var(--radius-sm);
  }

  .group__item img {
    max-height: 3rem;
    max-width: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .group__name {
    font-weight: 600;
    font-size: var(--text-base);
    color: var(--color-text);
    text-align: center;
    line-height: var(--leading-snug);
  }

  @media (max-width: 40rem) {
    .group__item {
      min-height: 5.5rem;
      padding: var(--space-md);
    }
    .group__item img {
      max-height: 2.5rem;
    }
  }
</style>
