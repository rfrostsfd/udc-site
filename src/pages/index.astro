---
/**
 * Landing page — the primary storytelling document, composed as an editorial
 * sequence rather than a stack of identical sections.
 *
 * Rhythm (top → bottom):
 *   EditorialHero → AudienceBand → What is UD (statement) →
 *   Why it matters (soft panel) → Who it helps (image split) →
 *   Benefits (light strip) → Fall prevention (three-panel band) →
 *   In practice (lead + example grid) → Events → Resources → Sponsors →
 *   Closing CTA (deep-green finale).
 *
 * Every section is modular and degrades gracefully when its CMS content is
 * missing, so sections can be added, removed, or reordered without a redesign.
 * Queries request only published, `active` content and exclude stale events
 * and expired sponsors.
 */
import { sanityClient } from 'sanity:client'
import Layout from '../layouts/Layout.astro'
import EditorialHero from '../components/EditorialHero.astro'
import AudienceBand from '../components/AudienceBand.astro'
import EditorialStory from '../components/EditorialStory.astro'
import BenefitsStrip from '../components/BenefitsStrip.astro'
import PreventionBand from '../components/PreventionBand.astro'
import PracticeExample from '../components/PracticeExample.astro'
import EventCard from '../components/EventCard.astro'
import ResourcePreview from '../components/ResourcePreview.astro'
import SponsorGroup from '../components/SponsorGroup.astro'
import ClosingCTA from '../components/ClosingCTA.astro'

const now = new Date().toISOString()
const today = now.slice(0, 10)

const [page, resources, sponsors, events] = await Promise.all([
  sanityClient.fetch(`
    *[_type == "landingPage"][0]{
      hero,
      whatIsUniversalDesign,
      whyItMatters,
      whoItHelps,
      audience,
      principles,
      inPractice,
      fallPrevention,
      resourcesIntro,
      sponsorsIntro,
      contactCta
    }
  `),
  sanityClient.fetch(`
    *[_type == "resource" && active == true]
      | order(featured desc, sortOrder asc, title asc){
        title, description, category, url, featured
      }
  `),
  sanityClient.fetch(
    `*[_type == "sponsor" && active == true && (!defined(endDate) || endDate >= $today)]
      | order(sortOrder asc, name asc){
        name, logo, url, description, level
      }`,
    { today }
  ),
  sanityClient.fetch(
    `*[_type == "event" && active == true && coalesce(endDate, startDate) >= $now]
      | order(startDate asc){
        title, startDate, endDate, description, location, url
      }`,
    { now }
  ),
])

const inPractice = page?.inPractice
const spaces = (inPractice?.spaces ?? []).filter((s: any) => s?.name)

// Landing page shows a small set of priority resources (featured first); the
// rest live on a future /resources page.
const RESOURCE_LIMIT = 6
const featuredResources = resources.slice(0, RESOURCE_LIMIT)
const hasMoreResources = resources.length > RESOURCE_LIMIT

// Group sponsors by level when levels are in use; otherwise a single flat group.
const SPONSOR_LEVELS = [
  { value: 'presenting', label: 'Presenting Sponsor', prominent: true },
  { value: 'supporting', label: 'Supporting Sponsors', prominent: false },
  { value: 'community-partner', label: 'Community Partners', prominent: false },
]
const sponsorGroups = SPONSOR_LEVELS.map((level) => ({
  ...level,
  items: sponsors.filter((s: any) => s.level === level.value),
})).filter((group) => group.items.length > 0)
const ungroupedSponsors = sponsors.filter(
  (s: any) => !SPONSOR_LEVELS.some((l) => l.value === s.level)
)
---

<Layout>
  <div id="top">
    <EditorialHero hero={page?.hero} />
  </div>

  <AudienceBand audience={page?.audience} />

  <EditorialStory
    id="what-is-universal-design"
    eyebrow="What is Universal Design?"
    heading={page?.whatIsUniversalDesign?.heading}
    body={page?.whatIsUniversalDesign?.body}
    image={page?.whatIsUniversalDesign?.image}
    variant="statement"
  />

  <PreventionBand id="fall-prevention" data={page?.fallPrevention} />

  <EditorialStory
    id="why-it-matters"
    heading={page?.whyItMatters?.heading}
    body={page?.whyItMatters?.body}
    image={page?.whyItMatters?.image}
    variant="image-left"
    tone="panel"
  />

  <EditorialStory
    id="who-it-helps"
    heading={page?.whoItHelps?.heading}
    body={page?.whoItHelps?.body}
    image={page?.whoItHelps?.image}
    variant="image-right"
  />

  <BenefitsStrip data={page?.principles} />

  {spaces.length > 0 && (
    <section id="in-practice" class="feature">
      <div class="feature__inner section-shell">
        <div class="feature__lead">
          <h2 class="display feature__heading">
            {inPractice?.heading ?? 'In practice'}
          </h2>
          <span class="accent-rule"></span>
          {inPractice?.intro && <p class="feature__text">{inPractice.intro}</p>}
        </div>
        <div class="feature__grid feature__grid--practice">
          {spaces.map((space: any) => (
            <PracticeExample space={space} />
          ))}
        </div>
      </div>
    </section>
  )}

  {events.length > 0 && (
    <section id="events" class="listing">
      <div class="listing__inner section-shell">
        <h2 class="display listing__heading">Upcoming events</h2>
        <span class="accent-rule"></span>
        <div class="feature__grid feature__grid--events">
          {events.map((event: any) => (
            <EventCard event={event} />
          ))}
        </div>
      </div>
    </section>
  )}

  <section id="resources" class="listing listing--panel">
    <div class="listing__inner section-shell">
      <header class="listing__header">
        <h2 class="display listing__heading">
          {page?.resourcesIntro?.heading ?? 'Helpful resources'}
        </h2>
        <span class="accent-rule"></span>
        {page?.resourcesIntro?.body && (
          <p class="feature__text">{page.resourcesIntro.body}</p>
        )}
      </header>
      {featuredResources.length > 0 ? (
        <>
          <div class="feature__grid feature__grid--resources">
            {featuredResources.map((resource: any) => (
              <ResourcePreview resource={resource} />
            ))}
          </div>
          {hasMoreResources && (
            <p class="listing__action">
              <a class="text-link" href="/resources">Browse all resources ({resources.length})</a>
            </p>
          )}
        </>
      ) : (
        <p class="feature__text">Resources are on the way. Please check back soon.</p>
      )}
    </div>
  </section>

  {sponsors.length > 0 && (
    <section id="sponsors" class="listing">
      <div class="listing__inner section-shell">
        <header class="listing__header">
          <h2 class="display listing__heading">
            {page?.sponsorsIntro?.heading ?? 'Our partners make it possible'}
          </h2>
          <span class="accent-rule"></span>
          {page?.sponsorsIntro?.body && (
            <p class="feature__text">{page.sponsorsIntro.body}</p>
          )}
        </header>

        {sponsorGroups.map((group) => (
          <SponsorGroup label={group.label} items={group.items} prominent={group.prominent} />
        ))}
        {ungroupedSponsors.length > 0 && (
          <SponsorGroup
            label={sponsorGroups.length > 0 ? 'More partners' : undefined}
            items={ungroupedSponsors}
          />
        )}
      </div>
    </section>
  )}

  <ClosingCTA data={page?.contactCta} />
</Layout>

<style>
  /* ---- Feature section: an editorial lead beside a grid of items ---- */
  .feature {
    padding-block: var(--space-2xl);
    background-color: var(--color-bg-alt);
  }
  .feature__inner {
    display: grid;
    gap: var(--space-xl);
  }
  @media (min-width: 60rem) {
    .feature__inner {
      grid-template-columns: minmax(13rem, 0.55fr) 2fr;
      gap: var(--space-2xl);
      align-items: start;
    }
  }

  .feature__heading {
    font-size: var(--text-3xl);
    margin: 0;
  }
  .feature__text {
    color: var(--color-muted);
    font-size: var(--text-lg);
    margin: 0;
    max-width: 42ch;
  }

  .feature__grid {
    display: grid;
    gap: var(--space-xl) var(--space-lg);
  }
  .feature__grid--practice {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
  }
  .feature__grid--events {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    margin-top: var(--space-lg);
  }
  .feature__grid--resources {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
  }

  /* ---- Listing section (events, resources, sponsors) ---- */
  .listing {
    padding-block: var(--space-2xl);
  }
  .listing--panel {
    background-color: var(--color-bg-alt);
  }
  .listing__header {
    max-width: var(--content-width);
    margin-bottom: var(--space-xl);
  }
  .listing__heading {
    font-size: var(--text-3xl);
    margin: 0;
  }
  .listing__action {
    margin: var(--space-xl) 0 0;
  }
</style>
