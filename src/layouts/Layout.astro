---
/**
 * Base page layout: HTML shell, SEO/Open Graph metadata, and the shared
 * header/footer chrome. Pages pass their own title/description; anything not
 * provided falls back to the organization's Default SEO in Site Settings.
 */
import { sanityClient } from 'sanity:client'
import { urlFor } from '../lib/sanity'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import TextSize from '../components/TextSize.astro'
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
}

const { title, description } = Astro.props

const settings = await sanityClient.fetch(`
  *[_type == "siteSettings"][0]{
    organizationName,
    shortName,
    logo,
    favicon,
    email,
    phone,
    address,
    socialLinks,
    defaultSeo
  }
`)

const orgName = settings?.organizationName ?? 'Universal Design Coalition'
const pageTitle = title
  ? `${title} · ${settings?.shortName ?? orgName}`
  : (settings?.defaultSeo?.title ?? orgName)
const metaDescription =
  description ?? settings?.defaultSeo?.description ?? ''

const shareImage = settings?.defaultSeo?.shareImage
  ? urlFor(settings.defaultSeo.shareImage).width(1200).height(630).fit('crop').url()
  : null

// A favicon uploaded in Site Settings overrides the static default icon.
const faviconUrl = settings?.favicon?.asset
  ? urlFor(settings.favicon).width(64).height(64).fit('crop').format('png').url()
  : null
const appleTouchUrl = settings?.favicon?.asset
  ? urlFor(settings.favicon).width(180).height(180).fit('crop').format('png').url()
  : null

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Apply a saved text-size preference before first paint to avoid a flash.
      try {
        var s = localStorage.getItem('udc-text-scale')
        if (s && s !== 'normal') document.documentElement.dataset.textScale = s
      } catch (e) {}
    </script>
    {faviconUrl ? (
      <>
        <link rel="icon" type="image/png" href={faviconUrl} />
        <link rel="apple-touch-icon" href={appleTouchUrl} />
      </>
    ) : (
      <>
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
      </>
    )}
    <title>{pageTitle}</title>
    {metaDescription && <meta name="description" content={metaDescription} />}
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    {metaDescription && <meta property="og:description" content={metaDescription} />}
    <meta property="og:url" content={canonical} />
    {shareImage && <meta property="og:image" content={shareImage} />}
    <meta name="twitter:card" content={shareImage ? 'summary_large_image' : 'summary'} />

    <meta name="generator" content={Astro.generator} />
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <div class="utility-bar">
      <div class="utility-bar__inner">
        <TextSize />
      </div>
    </div>
    <Header settings={settings} />
    <main id="main">
      <slot />
    </main>
    <Footer settings={settings} />
  </body>
</html>
